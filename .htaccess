Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^(?:app|tools|tests|vendor)(?:/|$) - [F,L]
RewriteRule ^(?:composer\.(?:json|lock)|README\.md|\.git.*)$ - [F,L]
RewriteRule ^(index|hidromak|katmerciler|catalog|product)\.html$ $1.php [QSA,L]
RewriteRule ^robots\.txt$ robots.php [L]
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>
